    "%@ 年的每一笔，都算数": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年的每一笔，都算数"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every bit saved in %@ counts"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年的每一筆，都算數"
          }
        }
      }
    },
    "30 天从首次打开起计算，领取或恢复凭证不会重新开始试用。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天从首次打开起计算，领取或恢复凭证不会重新开始试用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 30 days start on first launch. Claiming or restoring the receipt does not restart the trial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "30 天從首次開啟起計算，領取或回復憑證不會重新開始試用。"
          }
        }
      }
    },
